# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
SAASREVIEWS_DATABASE=/app/data/saasreviews.sqlite

# Optional first key when the keys table is empty. sr_live_... or sr_test_...
# SAASREVIEWS_BOOTSTRAP_KEY=sr_live_replace_me

# Off by default. Set to 1 (or true/yes) to fetch public G2/Capterra HTML.
# Leave unset or 0 in CI. SAASREVIEWS_FIXTURE_ONLY=1 always wins.
SAASREVIEWS_LIVE_DIRECTORIES=0
